{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spotiamp+",
  "version": "0.7.5",
  "identifier": "app.spotiamp",
  "build": {
    "beforeDevCommand": "node scripts/build-projectm.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-projectm.mjs && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBQkJDREQyNUUyN0EwRjcKUldUM29DZGUwczI3MmtHNUkzMXNVdVMwL2VmczR0ei9BSU9SNjllbHQzUUxaQmdnTjlQSDIvUlcK",
      "endpoints": [
        "https://github.com/fdeox/spotiamp-plus/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (c) 2026 fdeox. Based on Spotiamp, (c) 2025 Ted Steen. MIT License.",
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": {
      "milkdrop/projectM-4.dll": "projectM-4.dll",
      "milkdrop/glew32.dll": "glew32.dll",
      "milkdrop/LICENSE-projectM.txt": "licenses/LICENSE-projectM.txt",
      "milkdrop/LICENSE-GLEW.txt": "licenses/LICENSE-GLEW.txt",
      "milkdrop/VERSIONS.txt": "licenses/MILKDROP-VERSIONS.txt",
      "presets/": "presets/",
      "textures/": "textures/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    },
    "macOS": {}
  }
}